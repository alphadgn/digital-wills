# Copy to .env and fill in. .env is gitignored - never commit real values.
# This repository is public.

# ── Frontend (Vite; these are bundled into the client and are public by design) ──
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_PRIVY_APP_ID=""

# ── Contract deployment (SECRET - never commit, never paste into a browser) ──
# Deployer EOA private key, 0x-prefixed. Used only by contracts/script/Deploy.s.sol.
# Prefer a throwaway deployer funded with just enough gas, and rotate after deploying.
# Foundry reads .env from the directory you run `forge` in, so either run forge from
# the repo root or keep a copy at contracts/.env (also gitignored).
DEPLOYER_KEY=""

# ── Edge function secrets (set via `supabase secrets set`, NOT in this file) ──
# PRIVY_APP_SECRET
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# RESEND_API_KEY
# RESEND_FROM
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER
# APP_ORIGIN
